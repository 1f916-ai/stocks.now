{
  "name": "stocks-now",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "routes": [
    { "pattern": "stocks.now/*", "zone_name": "stocks.now" },
    { "pattern": "www.stocks.now/*", "zone_name": "stocks.now" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stocks-now",
      "database_id": "fbdf2182-0222-4b67-a024-923951801682",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      // Record prices every 5 minutes, day and night: the 24/7 stocks trade at
      // their token's price on Base any hour. A run with no new prices records nothing.
      "*/5 * * * *",
      // The weekly close at Monday's opening bell, 9:30 am New York: 13:30 UTC under
      // daylight time, 14:30 under standard time. Both fire; the code acts only at the
      // real bell. Day names on purpose: in Cloudflare cron, 1 = Sunday.
      "30 13 * * mon",
      "30 14 * * mon"
    ]
  },
  "assets": { "directory": "./public" },
  // The share image (src/og.ts) bundles its fonts as bytes and the AI logos as text.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf", "**/*.jpg"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.svg"], "fallthrough": true }
  ],
  "observability": { "enabled": true }
}
